<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FlickpayPOS" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/fp_settings_accent</item>
        <item name="colorSecondary">@color/fp_settings_accent</item>
        <item name="colorSurface">@color/fp_settings_panel</item>
        <item name="android:colorBackground">@color/fp_settings_bg</item>
        <item name="android:windowBackground">@drawable/fp_launch_background</item>
        <item name="android:statusBarColor">@color/fp_settings_bg</item>
        <item name="android:navigationBarColor">@color/fp_settings_bg</item>
        <item name="materialSwitchStyle">@style/Widget.FlickpayPOS.Switch</item>
    </style>

    <style name="Theme.FlickpayPOS.Settings" parent="Theme.FlickpayPOS">
        <item name="android:windowBackground">@color/fp_settings_bg</item>
        <item name="android:statusBarColor">@color/fp_settings_bg</item>
        <item name="android:navigationBarColor">@color/fp_settings_bg</item>
    </style>

    <style name="Widget.FlickpayPOS.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/fp_settings_field_bg</item>
        <item name="boxStrokeColor">@color/fp_settings_divider</item>
        <item name="hintTextColor">@color/fp_settings_muted</item>
        <item name="boxCornerRadiusTopStart">6dp</item>
        <item name="boxCornerRadiusTopEnd">6dp</item>
        <item name="boxCornerRadiusBottomStart">6dp</item>
        <item name="boxCornerRadiusBottomEnd">6dp</item>
    </style>

    <style name="Widget.FlickpayPOS.DropdownInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxBackgroundColor">@color/fp_settings_field_bg</item>
        <item name="boxStrokeColor">@color/fp_settings_divider</item>
        <item name="hintTextColor">@color/fp_settings_muted</item>
        <item name="boxCornerRadiusTopStart">6dp</item>
        <item name="boxCornerRadiusTopEnd">6dp</item>
        <item name="boxCornerRadiusBottomStart">6dp</item>
        <item name="boxCornerRadiusBottomEnd">6dp</item>
    </style>

    <style name="Widget.FlickpayPOS.SecondaryButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/fp_settings_surface</item>
        <item name="android:textColor">@color/fp_settings_text</item>
        <item name="cornerRadius">6dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.FlickpayPOS.PrimaryButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/fp_settings_accent</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="cornerRadius">6dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.FlickpayPOS.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="useMaterialThemeColors">false</item>
        <item name="thumbIcon">@null</item>
        <item name="android:thumb">@drawable/fp_switch_thumb</item>
        <item name="android:track">@drawable/fp_switch_track</item>
        <item name="track">@drawable/fp_switch_track</item>
        <item name="thumbTint">@color/fp_switch_thumb_tint</item>
        <item name="trackTint">@color/fp_switch_track_tint</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">44dp</item>
    </style>
</resources>
